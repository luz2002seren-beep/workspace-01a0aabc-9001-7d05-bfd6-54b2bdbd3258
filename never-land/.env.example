# ==========================================================
#  Never Land  |  ملف الإعدادات (انسخه إلى .env وعدّل القيم)
# ==========================================================

# ---------- معلومات البوت (إلزامي) ----------
# من https://discord.com/developers/applications
DISCORD_TOKEN=ضع_توكن_البوت_هنا
CLIENT_ID=ضع_ايدي_التطبيق_هنا
# توكن التطبيق نفسه (Bot token) هو نفسه DISCORD_TOKEN، بعض الواجهات تحتاجه منفصل
CLIENT_SECRET=ضع_السر_هنا

# ---------- لوحة التحكم (Dashboard) ----------
# رابط العودة يجب أن يطابق حرفياً ما تضعه في Developer Portal > OAuth2 > Redirects
DASHBOARD_URL=http://localhost:3000
DASHBOARD_PORT=3000
SESSION_SECRET=# الوصول العام: true = أي زائر يفتح الموقع ويشاهد الصفحات والسيرفرات (بلا تعديل)
#                false = الموقع مغلق ولا يفتحه إلا من سجّل دخول بـ Discord
PUBLIC_ACCESS=false
# تأكيد الدخول: true = الموقع ما يفتحه إلا من سجّل دخول بحساب Discord
LOGIN_REQUIRED=true
# الرول المطلوب لاستخدام الموقع (معرّف الرول) — من لا يملكه يرى صفحة «الوصول مقيّد»
REQUIRED_ROLE_ID=1549364852433354792
# مدة كاش فحص الرول بالثواني
ROLE_CACHE_SECONDS=300
غيّر_هذا_النص_الطويل_لحماية_الجلسات
# ضع true لتشغيل اللوحة ببيانات تجريبية بدون تسجيل دخول (للمعاينة فقط)
DEMO_MODE=false

# ---------- إعدادات عامة ----------
# اللغة الافتراضية للبوت: ar أو en
DEFAULT_LANGUAGE=ar
# أيدي مطوري البوت (يفصلهم بفاصلة) — عندهم صلاحية أوامر المطوّر
DEVELOPER_IDS=
# مسار قاعدة البيانات
DATABASE_PATH=./data/neverland.db

# ---------- صلاحيات ودّية ----------
# حذف أوامر السلاش القديمة وإعادة تسجيلها عند كل تشغيل (لاستخدام التطوير فقط)
RESET_COMMANDS=false

# رابط دعوة البوت (اختياري — يُبنى تلقائيًا من CLIENT_ID)
# INVITE_URL=https://discord.com/oauth2/authorize?client_id=...&permissions=8&scope=bot%20applications.commands
