{
  "name": "never-land",
  "version": "1.0.0",
  "description": "Never Land — نظام إدارة سيرفرات ديسكورد (مودة + حماية + تذاكر + ترحيب + سجلات + مستويات) مع لوحة تحكم ويب عربية",
  "main": "src/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.17.0"
  },
